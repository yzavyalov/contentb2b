            --wr-border: #1c344d;
            --wr-border-strong: #2c4965;
            --wr-text: #ffffff;
            --wr-text-soft: #cbd5e1;
            --wr-muted: #94a3b8;
            --wr-muted-soft: #64748b;
            --wr-input: #07111f;
            --wr-topbar: rgba(6, 17, 31, .90);
        }

        html[data-theme="light"] {
            color-scheme: light;
            --wr-page: #f3f6fa;
            --wr-sidebar: #ffffff;
            --wr-panel: #ffffff;
            --wr-panel-secondary: #f8fafc;
