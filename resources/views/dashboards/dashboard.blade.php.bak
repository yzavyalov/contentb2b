            --wr-muted-soft: #94a3b8;
            --wr-input: #f8fafc;
            --wr-topbar: rgba(243, 246, 250, .92);
        }

        html[data-theme="dark"] {
            color-scheme: dark;
        }

        body {
            background: var(--wr-page);
            color: var(--wr-text);
            transition: background-color .15s ease, color .15s ease;
        }

        /* Compatibility layer for existing dark-only dashboard components. */
        html[data-theme="light"] [class~="bg-[#06111f]"],
        html[data-theme="light"] [class~="bg-[#081523]"],
        html[data-theme="light"] [class~="bg-[#0b192a]"] {
            background-color: var(--wr-panel) !important;
        }

        html[data-theme="light"] [class~="bg-[#07111f]"] {
            background-color: var(--wr-panel-secondary) !important;
        }

        html[data-theme="light"] [class~="bg-[#081726]/95"] {
            background-color: rgba(255, 255, 255, .96) !important;
        }

        html[data-theme="light"] [class~="text-white"] {
            color: var(--wr-text) !important;
        }

        html[data-theme="light"] [class~="text-slate-300"] { color: #334155 !important; }
        html[data-theme="light"] [class~="text-slate-400"] { color: #475569 !important; }
        html[data-theme="light"] [class~="text-slate-500"] { color: #64748b !important; }
        html[data-theme="light"] [class~="text-slate-600"] { color: #94a3b8 !important; }

        html[data-theme="light"] [class~="border-white/5"],
        html[data-theme="light"] [class~="border-white/10"],
        html[data-theme="light"] [class~="border-[#1c344d]"],
        html[data-theme="light"] [class~="border-[#2c4965]"] {
            border-color: var(--wr-border) !important;
        }

        html[data-theme="light"] [class~="bg-white/[0.04]"],
        html[data-theme="light"] [class~="bg-white/[0.05]"] {
            background-color: #f1f5f9 !important;
        }

        html[data-theme="light"] input,
        html[data-theme="light"] select,
        html[data-theme="light"] textarea {
            color: #0f172a;
        }

        html[data-theme="light"] input::placeholder,
        html[data-theme="light"] textarea::placeholder {
            color: #94a3b8;
        }

        .wr-theme-select {
            appearance: none;
            background-color: var(--wr-panel);
            border: 1px solid var(--wr-border-strong);
            color: var(--wr-text-soft);
        }

        .wr-theme-select:hover,
        .wr-theme-select:focus {
            border-color: #84cc16;
            outline: none;
        }
    </style>


